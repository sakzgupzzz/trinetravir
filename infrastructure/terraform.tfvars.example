aws_region          = "us-east-1"
instance_type       = "g5.xlarge"
key_name            = "stockbeat-key"
ssh_allowed_cidr    = "67.244.121.160/32"   # match StockBeat infra; update if home IP changes
root_volume_size_gb = 100

# Set to true for ~70% cost reduction; risks eviction (acceptable for ephemeral
# Session 4 single-run workload). Spot eviction protection not implemented.
use_spot       = false
spot_max_price = "0.40"
